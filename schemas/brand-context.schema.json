{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/silvermanjared-web/brand-context-system/schemas/brand-context.schema.json",
  "title": "Brand Context Bundle",
  "type": "object",
  "required": [
    "metadata",
    "brand",
    "audiences",
    "voice",
    "visual_system",
    "assets",
    "frontend_references",
    "figma_references",
    "review_rules"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["schema_version", "last_validated", "canonical_validator", "validation_scope", "status_values", "path_status_values"],
      "properties": {
        "schema_version": { "type": "string" },
        "last_validated": { "type": "string" },
        "canonical_validator": { "type": "string" },
        "validation_scope": { "type": "array", "items": { "type": "string" } },
        "status_values": { "type": "object" },
        "path_status_values": { "type": "object" }
      }
    },
    "brand": {
      "type": "object",
      "required": ["name", "short_description", "positioning"],
      "properties": {
        "name": { "type": "string" },
        "short_description": { "type": "string" },
        "positioning": { "type": "string" },
        "not_this": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "audiences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "needs", "decision_context"],
        "properties": {
          "name": { "type": "string" },
          "needs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "decision_context": { "type": "string" }
        }
      }
    },
    "voice": {
      "type": "object",
      "required": ["attributes", "rules", "avoid"],
      "properties": {
        "attributes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "avoid": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "visual_system": {
      "type": "object",
      "required": ["color", "typography", "layout", "imagery"],
      "properties": {
        "color": { "type": "object" },
        "typography": { "type": "object" },
        "layout": { "type": "object" },
        "imagery": { "type": "object" }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "path", "status", "path_status"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "path": { "type": "string" },
          "status": { "enum": ["sample-reference", "reference-only", "documented-placeholder"] },
          "path_status": { "enum": ["committed", "documented-only"] }
        }
      }
    },
    "frontend_references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "purpose", "status", "path_status"],
        "properties": {
          "path": { "type": "string" },
          "purpose": { "type": "string" },
          "status": { "enum": ["sample-reference", "reference-only", "documented-placeholder"] },
          "path_status": { "enum": ["committed", "documented-only"] }
        }
      }
    },
    "figma_references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "path_status", "purpose"],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "status": { "enum": ["sample-reference", "reference-only", "documented-placeholder"] },
          "path_status": { "enum": ["committed", "documented-only"] },
          "purpose": { "type": "string" }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "path_status": { "const": "committed" }
              },
              "required": ["path_status"]
            },
            "then": {
              "required": ["path"]
            }
          }
        ]
      }
    },
    "review_rules": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string" }
    }
  }
}
